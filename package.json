{
  "name": "nexusai-enterprise-platform",
  "version": "1.0.0",
  "description": "NexusAI: The Multi-Tenant Enterprise Knowledge & Workflow Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "tunnel": "node scripts/tunnel.js",
    "share": "concurrently -k -n \"SERVERS,TUNNEL\" -c \"cyan,green\" \"npm run dev\" \"node scripts/tunnel.js\""
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "dependencies": {
    "@google/genai": "^2.25.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "concurrently": "^9.1.2"
  }
}
