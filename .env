# Server Configuration
PORT=5005
NODE_ENV=development

# Database Connection (Local PostgreSQL or Supabase Cloud URI)
# For Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://localhost:5432/nexusai_db

# Supabase Cloud Project Configuration (Optional for Supabase Client SDK)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Authentication Secret
JWT_SECRET=super_secret_enterprise_jwt_key_change_in_production
SESSION_EXPIRY=24h
