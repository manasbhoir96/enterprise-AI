# ==============================================================================
# NexusAI Enterprise Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env (and server/.env) to configure your environment.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5005
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connection (Required)
# ------------------------------------------------------------------------------
# Default: Local PostgreSQL database
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://localhost:5432/nexusai_db

# Supabase PostgreSQL Connection String (Optional / For Cloud Database):
# You can copy this directly from your Supabase Dashboard:
# Project Settings -> Database -> Connection String (URI / Pooler mode)
# Example:
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Configuration (Optional)
# ------------------------------------------------------------------------------
# Only needed if using Supabase client libraries directly
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 4. Google Gemini AI Configuration (Configured)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 5. Security & Authentication (Required)
# ------------------------------------------------------------------------------
# A secure, unpredictable secret used to sign JSON Web Tokens
JWT_SECRET=super_secret_enterprise_jwt_key_change_in_production
SESSION_EXPIRY=24h
